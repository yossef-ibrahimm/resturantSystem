# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/tastytable?schema=public"

# JWT — MUST change in production
JWT_SECRET="<strong-random-64-char-secret>"
JWT_EXPIRES_IN="24h"

# Server
PORT=3001

# MinIO / S3
MINIO_ENDPOINT="your-minio-host"
MINIO_PORT=9000
MINIO_ACCESS_KEY="your-access-key"
MINIO_SECRET_KEY="your-secret-key"
MINIO_BUCKET="tastytable-images"
MINIO_USE_SSL=false

# Frontend URL (comma-separated for multiple origins)
FRONTEND_URL="https://your-domain.com"
