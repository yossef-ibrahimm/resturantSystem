# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tastytable?schema=public"

# JWT
JWT_SECRET="tastytable-secret-change-in-production"
JWT_EXPIRES_IN="24h"

# Server
PORT=3001

# MinIO / S3
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="tastytable-images"
MINIO_USE_SSL=false

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:8080"
