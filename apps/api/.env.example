# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:3001/tastytable?schema=public"

# JWT — SET A STRONG RANDOM SECRET IN PRODUCTION
JWT_SECRET="change-this-to-a-strong-random-secret"
JWT_EXPIRES_IN="24h"

# Server
PORT=3001

# MinIO / S3 — CHANGE THESE IN PRODUCTION
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="tastytable-images"
MINIO_USE_SSL=false

# Frontend URL (for CORS — comma-separated if multiple)
FRONTEND_URL="http://localhost:8080"

# Node environment
NODE_ENV=development
